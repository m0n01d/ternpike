{% import "partials/icons.njk" as icons %}
<section class="topo topo-how relative overflow-hidden bg-parchment px-6 py-25" id="how">
  <div class="relative z-10 mx-auto max-w-[1100px]">
    <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.22em] text-rust [font-variant-caps:all-small-caps]">{{ howItWorks.eyebrow }}</div>
    <h2 class="font-display text-[clamp(36px,6vw,60px)] font-black leading-[1.05] tracking-[-0.02em] text-forest">{{ howItWorks.seoHeadline }}</h2>
    <p class="section-subhead mb-15">{{ howItWorks.headlineHtml | safe }}</p>

    <div class="relative grid grid-cols-1 items-stretch gap-5 md:grid-cols-3 md:gap-8">
      {% for step in howItWorks.steps %}
      <div class="relative flex flex-col rounded-card bg-cream-deep px-8 pb-8 pt-9 shadow-card transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-card-hover">
        <div class="mb-[18px] font-mono text-[11px] uppercase tracking-[0.22em] text-rust [font-variant-caps:all-small-caps]">{{ step.number }}</div>
        <div class="mb-[14px] text-forest leading-none">{{ icons.icon(step.iconName) }}</div>
        <div class="mb-2.5 font-display text-2xl font-bold leading-[1.2] tracking-[-0.01em] text-forest">{{ step.title }}</div>
        <div class="font-body text-lg leading-[1.65] text-forest-mid">{{ step.body }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
