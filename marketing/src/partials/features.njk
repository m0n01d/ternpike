<section class="features topo topo-features" id="features">
  <div class="features-inner">
    <div class="section-eyebrow">{{ features.eyebrow }}</div>
    <h2 class="section-h2">{{ features.headlineHtml | safe }}</h2>

    <div class="feat-grid">
      {% for item in features.items %}
      <div class="feat-card">
        <div class="feat-icon">{{ item.icon }}</div>
        <div class="feat-title">{{ item.title }}</div>
        <div class="feat-body">{{ item.body }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
