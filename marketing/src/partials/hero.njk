<section class="topo topo-hero relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-cream pt-[120px] px-6 pb-20 before:content-[''] before:absolute before:inset-0 before:bg-[repeating-linear-gradient(to_bottom,transparent_0px,transparent_39px,rgb(74_94_58_/0.07)_39px,rgb(74_94_58_/0.07)_40px)] before:pointer-events-none">
  <div class="absolute inset-y-0 left-[clamp(40px,8vw,80px)] w-px bg-[rgb(184_92_56_/0.18)]"></div>
  <div class="relative z-10 flex flex-col items-center text-center max-w-[820px] animate-fade-up">

    <div class="mb-6 animate-soar animate-fade-up [animation-delay:50ms]">
      <svg width="120" height="80" viewBox="0 0 120 80" fill="none">
        <path d="M60 40 C40 26, 8 20, 0 29 C16 28, 38 34, 60 44Z" fill="var(--color-forest)"/>
        <path d="M60 40 C80 26, 112 20, 120 29 C104 28, 82 34, 60 44Z" fill="var(--color-forest-mid)"/>
        <ellipse cx="60" cy="43" rx="20" ry="7" fill="var(--color-forest)"/>
        <path d="M44 47 L28 62" stroke="var(--color-forest)" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M44 47 L34 65" stroke="var(--color-forest)" stroke-width="2" stroke-linecap="round"/>
        <ellipse cx="76" cy="40" rx="9" ry="7" fill="var(--color-ink)"/>
        <path d="M84 40 L96 38.5 L84 42Z" fill="var(--color-rust)"/>
        <circle cx="79" cy="38.5" r="1.8" fill="var(--color-tan)"/>
        <circle cx="79.5" cy="38.5" r="0.8" fill="var(--color-ink)"/>
      </svg>
    </div>

    <h1 class="font-display font-black text-[clamp(40px,7vw,76px)] tracking-[-0.025em] leading-[1.02] text-forest max-w-[880px] animate-fade-up [animation-delay:150ms]">
      {% for line in hero.headline.lines %}
      <span class="block{% if not loop.first %} text-rust{% endif %}">{{ line }}</span>
      {% endfor %}
    </h1>

    <div class="mt-6 max-w-[620px] animate-fade-up [animation-delay:250ms]">
      {% for paragraph in hero.sub %}
      <p class="font-body text-[clamp(17px,2.2vw,20px)] text-moss leading-[1.5]{% if not loop.first %} mt-2{% endif %}">{{ paragraph }}</p>
      {% endfor %}
    </div>

    <div class="flex flex-wrap justify-center gap-4 mt-10 animate-fade-up [animation-delay:350ms]">
      {% for action in hero.actions %}
        {% if action.kind == "primary" %}
      <a href="{{ action.href }}" class="inline-flex items-center font-mono text-[11px] tracking-[0.15em] uppercase bg-rust text-parchment px-8 py-4 rounded-lg no-underline shadow-[0_4px_16px_rgb(184_92_56_/0.25)] transition-[background-color,transform,box-shadow] duration-200 hover:bg-rust-deep hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgb(184_92_56_/0.3)]">{{ action.label }}{% if action.arrow %}<span class="ml-2.5 inline-block leading-none">&rarr;</span>{% endif %}</a>
        {% else %}
      <a href="{{ action.href }}" class="inline-flex items-center font-mono text-[11px] tracking-[0.15em] uppercase text-moss px-6 py-4 rounded-lg no-underline border border-tan transition-[border-color,color,transform] duration-200 hover:border-moss hover:text-forest hover:-translate-y-0.5">{{ action.label }}{% if action.arrow %}<span class="ml-2.5 inline-block leading-none">&rarr;</span>{% endif %}</a>
        {% endif %}
      {% endfor %}
    </div>

    <p class="mt-12 font-mono text-[10px] tracking-[0.22em] uppercase text-moss animate-fade-up [animation-delay:450ms]">{{ hero.proof }}</p>

  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 animate-fade-up [animation-delay:800ms]">
    <div class="w-1.5 h-1.5 rounded-full bg-tan animate-scroll-pulse"></div>
    <div class="w-1.5 h-1.5 rounded-full bg-tan animate-scroll-pulse [animation-delay:200ms]"></div>
    <div class="w-1.5 h-1.5 rounded-full bg-tan animate-scroll-pulse opacity-40 [animation-delay:400ms]"></div>
  </div>
</section>
