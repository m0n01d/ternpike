<section class="topo topo-hero relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-cream pt-[120px] px-6 pb-20 before:content-[''] before:absolute before:inset-0 before:z-[2] before:bg-[repeating-linear-gradient(to_bottom,transparent_0px,transparent_39px,rgb(242_237_227_/0.06)_39px,rgb(242_237_227_/0.06)_40px)] before:pointer-events-none">
  <img class="absolute inset-0 z-0 h-full w-full object-cover" src="/img/hero-alaska-range.jpg" alt="Green valley and mountain range under a cloudy Alaska sky" width="2400" height="1601" fetchpriority="high">
  <div aria-hidden="true" class="absolute inset-0 z-[1] mix-blend-multiply bg-[linear-gradient(180deg,rgb(30_40_24_/0.30)_0%,rgb(30_40_24_/0.62)_100%),radial-gradient(120%_90%_at_50%_0%,rgb(107_124_88_/0.25),transparent_60%)]"></div>
  <div class="absolute inset-y-0 left-[clamp(40px,8vw,80px)] z-[2] w-px bg-[rgb(212_201_168_/0.22)]"></div>
  <div class="relative z-10 flex flex-col items-center text-center max-w-[820px] animate-fade-up">

    <div class="mb-6 animate-soar animate-fade-up [animation-delay:50ms]">
      <svg width="120" height="80" viewBox="0 0 120 80" fill="none">
        <path d="M60 40 C40 26, 8 20, 0 29 C16 28, 38 34, 60 44Z" fill="var(--color-cream)"/>
        <path d="M60 40 C80 26, 112 20, 120 29 C104 28, 82 34, 60 44Z" fill="var(--color-tan)"/>
        <ellipse cx="60" cy="43" rx="20" ry="7" fill="var(--color-cream)"/>
        <g transform="rotate(-12 42 43)">
          <path d="M42 43 L18 38" stroke="var(--color-cream)" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M42 43 L18 48" stroke="var(--color-cream)" stroke-width="2" stroke-linecap="round"/>
        </g>
        <ellipse cx="76" cy="40" rx="9" ry="7" fill="var(--color-ink)"/>
        <path d="M84 40 L96 38.5 L84 42Z" fill="var(--color-rust-light)"/>
        <circle cx="79" cy="38.5" r="1.8" fill="var(--color-tan)"/>
        <circle cx="79.5" cy="38.5" r="0.8" fill="var(--color-cream)"/>
      </svg>
    </div>

    <h1 class="font-display font-black text-[clamp(36px,6.4vw,68px)] tracking-[-0.025em] leading-[1.04] text-cream max-w-[880px] [text-shadow:0_2px_24px_rgb(26_36_18_/0.45)] animate-fade-up [animation-delay:150ms]">{{ hero.headline }}</h1>

    <p class="hero-subhead animate-fade-up [animation-delay:200ms]">{{ hero.subheadline }}</p>

    <div class="mt-6 max-w-[620px] animate-fade-up [animation-delay:250ms]">
      {% for paragraph in hero.sub %}
      <p class="font-body text-[clamp(17px,2.2vw,20px)] text-cream/90 leading-[1.5]{% if not loop.first %} mt-2{% endif %}">{{ paragraph }}</p>
      {% endfor %}
    </div>

    <div class="flex flex-wrap justify-center gap-4 mt-10 animate-fade-up [animation-delay:350ms]">
      {% for action in hero.actions %}
        {% if action.kind == "primary" %}
      <a href="{{ action.href }}" class="inline-flex items-center font-mono text-[11px] tracking-[0.15em] uppercase bg-rust text-parchment px-8 py-4 rounded-lg no-underline shadow-[0_4px_16px_rgb(184_92_56_/0.25)] transition-[background-color,transform,box-shadow] duration-200 hover:bg-rust-deep hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgb(184_92_56_/0.3)]">{{ action.label }}{% if action.arrow %}<span class="ml-2.5 inline-block leading-none">&rarr;</span>{% endif %}</a>
        {% else %}
      <a href="{{ action.href }}" class="inline-flex items-center font-mono text-[11px] tracking-[0.15em] uppercase text-cream px-6 py-4 rounded-lg no-underline border border-cream/40 bg-cream/10 backdrop-blur-sm transition-[background-color,border-color,color,transform] duration-200 hover:bg-cream/20 hover:border-cream/70 hover:text-cream hover:-translate-y-0.5">{{ action.label }}{% if action.arrow %}<span class="ml-2.5 inline-block leading-none">&rarr;</span>{% endif %}</a>
        {% endif %}
      {% endfor %}
    </div>

    <p class="mt-12 font-mono text-[10px] tracking-[0.22em] uppercase text-tan animate-fade-up [animation-delay:450ms]">{{ hero.proof }}</p>

  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 animate-fade-up [animation-delay:800ms]">
    <div class="w-1.5 h-1.5 rounded-full bg-tan animate-scroll-pulse"></div>
    <div class="w-1.5 h-1.5 rounded-full bg-tan animate-scroll-pulse [animation-delay:200ms]"></div>
    <div class="w-1.5 h-1.5 rounded-full bg-tan animate-scroll-pulse opacity-40 [animation-delay:400ms]"></div>
  </div>
</section>
