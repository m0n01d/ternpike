<section class="relative overflow-hidden py-[100px] px-6 bg-cream" id="compare">
  <div class="max-w-[1000px] mx-auto relative z-10">
    <div class="font-mono text-[10px] tracking-[0.25em] uppercase text-rust mb-3">{{ comparison.eyebrow }}</div>
    <h2 class="font-display font-black text-[clamp(36px,6vw,60px)] tracking-[-0.02em] leading-[1.05] text-forest mb-[60px]">{{ comparison.headline }}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
      {% for col in comparison.columns %}
      <div class="{% if col.kind == 'us' %}shadow-card rounded-xl overflow-hidden{% else %}opacity-95{% endif %}">
        <div class="font-mono text-[9px] tracking-[0.2em] uppercase py-2.5 px-4 rounded-t-md {% if col.kind == 'us' %}bg-forest text-tan{% else %}bg-muted/15 text-muted{% endif %}">{{ col.heading }}</div>
        <div class="rounded-b-xl overflow-hidden border border-t-0 border-tan">
          {% for row in col.rows %}
          <div class="flex items-center gap-3 py-3.5 px-4 border-b border-tan/50 last:border-b-0 font-body text-base leading-[1.3] {% if col.kind == 'us' %}bg-parchment/60 text-forest font-medium{% else %}bg-parchment text-muted{% endif %}"><span class="shrink-0 text-sm {% if col.kind == 'us' %}text-rust{% else %}text-muted opacity-70{% endif %}">{{ row.icon }}</span> <span>{{ row.text }}</span></div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
