<section class="why" id="compare">
  <div class="why-inner">
    <div class="section-eyebrow">{{ comparison.eyebrow }}</div>
    <h2 class="section-h2">{{ comparison.headline }}</h2>

    <div class="compare">
      {% for col in comparison.columns %}
      <div class="compare-col">
        <div class="compare-head {{ col.kind }}">{{ col.heading }}</div>
        <div class="compare-body">
          {% for row in col.rows %}
          <div class="compare-row{% if col.kind == 'us' %} us-row{% endif %}"><span class="c-icon">{{ row.icon }}</span> {{ row.text }}</div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
