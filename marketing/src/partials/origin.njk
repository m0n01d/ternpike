<section class="origin" id="origin">
  <div class="origin-inner">
    <div class="origin-eyebrow">{{ origin.eyebrow }}</div>
    <h2 class="origin-h2">{{ origin.headline }}</h2>
    <div class="origin-body">
      {% for p in origin.paragraphs %}
      <p class="origin-p">{{ p }}</p>
      {% endfor %}
    </div>
    <p class="origin-attribution">{{ origin.attribution }}</p>
  </div>
</section>
