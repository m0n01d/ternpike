{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ternpike",
  "compatibility_date": "2026-05-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Deployed staging app: serves a dist/ built with the staging API baked in
  // (npm run deploy:staging — never plain `wrangler deploy --env staging`,
  // the build step is what points the bundle at ternpike-auth-staging).
  // Named `staging-ternpike` so the API's PREVIEW_ORIGIN CORS regex
  // (<anything>-ternpike.dwightdoane.workers.dev) matches it as-is.
  "env": {
    "staging": {
      "name": "staging-ternpike",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
