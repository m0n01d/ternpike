COUCH_URL=https://couch.ternpike.com
COUCH_ADMIN_USER=admin
COUCH_ADMIN_PASS=

# 32+ random chars; rotating invalidates every user's stored creds.
# Generate: openssl rand -hex 32
SERVER_SECRET=

# Resend API key from https://resend.com (used for sending verification codes).
RESEND_API_KEY=

# Web Push VAPID public key — the JS-side `pushManager.subscribe()` uses this
# as the applicationServerKey. Pair it with the server-side `VAPID_PRIVATE_KEY`
# used by the push-send worker (lands with #179). Generate via:
#   npx web-push generate-vapid-keys
# Leave blank in development if you don't need to test real push delivery;
# Settings → Notifications still renders, but the subscribe call will report
# "VAPID public key not configured" rather than register a subscription.
VITE_VAPID_PUBLIC_KEY=
