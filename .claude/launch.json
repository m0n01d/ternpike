{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ternpike-staging",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:staging"],
      "port": 3000
    },
    {
      "name": "alaska-tracker",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3000"],
      "port": 3000
    },
    {
      "name": "marketing",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3100", "--directory", "marketing/dist"],
      "port": 3100
    }
  ]
}
