{
  "name": "ternpike",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,magenta \"vite\" \"npm --prefix server run dev\"",
    "dev:vite": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "elm-verify-examples && npx elm-test",
    "test:server": "npm --prefix server run test:server",
    "format": "elm-format src --yes",
    "format:check": "elm-format src --validate",
    "review": "elm-review",
    "review:fix": "elm-review --fix-all",
    "e2e": "vite build && playwright test --config=e2e/playwright.config.ts",
    "e2e:headed": "vite build && playwright test --config=e2e/playwright.config.ts --headed",
    "e2e:update-snapshots": "vite build && playwright test --config=e2e/playwright.config.ts --update-snapshots",
    "e2e:marketing": "playwright test --config=marketing/playwright.config.ts",
    "e2e:marketing:live": "WAITLIST_LIVE=1 playwright test --config=marketing/playwright.config.ts --grep live",
    "admin": "npm --prefix scripts/admin start"
  },
  "devDependencies": {
    "@caseywebb/elmq": "^0.8.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.0",
    "elm-format": "^0.8.8",
    "elm-review": "^2.13.5",
    "elm-verify-examples": "^6.0.3",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.13",
    "vite-plugin-elm": "^3.0.1"
  },
  "dependencies": {
    "@github/relative-time-element": "^5.0.0",
    "elm": "^0.19.1-6",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pouchdb": "^9.0.0"
  }
}
